# Only needed to build the firmware yourself; the published release needs no secrets file.
# Copy to secrets.yaml and fill in. secrets.yaml is gitignored.
# Choose your own values: the ones below are public.

# Wi-Fi network the board joins
wifi_ssid: "MyNetwork"
wifi_password: "my-wifi-password"

# Recovery access point (OpenHydronic-AP), minimum 8 characters
ap_password: "openhydronic"

# Native API encryption key, 32 random bytes in base64.
# Generate at https://esphome.io/components/api.html or with:
#   head -c 32 /dev/urandom | base64
api_encryption_key: "REPLACE_WITH_A_32_BYTE_BASE64_KEY="

# OTA update password
ota_password: "my-ota-password"

# Standalone web server on port 80
web_username: "admin"
web_password: "my-web-password"
